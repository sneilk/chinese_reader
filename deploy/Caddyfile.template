# Caddy для chinese_reader (T1.17).
#
# Шаблон: {{DOMAIN}} и {{PASSWORD_HASH}} подставляет deploy/setup-vm.sh.
# Готовый Caddyfile живёт только на машине — в репозитории ему делать нечего,
# там хеш пароля.
#
# Домен вида 89-169-158-177.sslip.io резолвится в IP, зашитый в само имя,
# поэтому DNS-записи заводить не нужно и Let's Encrypt выдаёт сертификат как
# на обычное имя. Обратная сторона: **имя привязано к адресу**, а публичный IP
# у ВМ эфемерный. Пересоздадите машину — домен сменится вместе с адресом, и
# Caddyfile придётся перевыпустить.

{{DOMAIN}} {
	encode zstd gzip

	# Пароль на всё разом: сервис личный, и открытых страниц в нём нет.
	basicauth {
		reader {{PASSWORD_HASH}}
	}

	# API — на бэкенд. Он слушает только петлю, снаружи его нет.
	handle /api/* {
		reverse_proxy 127.0.0.1:8000 {
			# Загрузка главы идёт через браузер и перевод: минуты, а не секунды.
			# Дефолтных таймаутов Caddy хватает, но ответ ждём терпеливо.
			transport http {
				response_header_timeout 120s
			}
		}
	}

	# Фронт — статика, собранная Vite. try_files нужен для маршрутов на хеше
	# только формально, но пусть будет: перезагрузка любой страницы отдаёт
	# index.html, а не 404.
	handle {
		root * /opt/chinese-reader/web
		try_files {path} /index.html
		file_server
	}

	log {
		output stderr
		format console
	}
}
