[Unit]
Description=Ночная резервная копия chinese_reader

[Timer]
# Ночью, когда читать точно не будут: копия базы со словарями занимает
# несколько секунд, но диск в это время лучше не трогать.
OnCalendar=*-*-* 04:00:00
# Разброс, чтобы копия не совпадала секунда в секунду с чем-нибудь ещё.
RandomizedDelaySec=20m
# Машина была выключена в четыре утра — копия снимется при следующем старте,
# а не пропустится молча до завтра.
Persistent=true

[Install]
WantedBy=timers.target
